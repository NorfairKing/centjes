currency CHF 0.01

tag taxable

account equity:starting
account assets:bank
  + tag taxable
account assets:federal
  + tag taxable
account assets:wealth-tax
  + tag taxable
account expenses:cantonal
account income:domestic
account liabilities:taxes:sva
  + assert virtual-only

