import ledger
import banks/ubs-2024
import my ledger

-- This is a comment
currency USD 0.01
currency SWDA 1

tag deductible

account assets
account assets:bank
account special assets
account liabilities:credit-card liabilities
account other-stuff other
account income:gifts income
account expenses:coffee expenses
account equity:opening equity
account assets:cash
  -- An indented comment, above the extra it belongs to
  + assert currency CHF
  + assert no-virtual
  + attach foo.txt
  + attach foo/bar.txt
  + attach my bank statement.pdf
  + attach a--b.pdf
  + tag deductible
account expenses:vat
  + assert virtual-allowed
account virtual:only
  + assert virtual-only

price 2023-12-11 CHF 1.14 USD
price 2023-12-11 07:42 CHF 1.14 USD
price 2023-12-11 07:42:13 CHF 1 / 7 USD

