currency CHF 0.01

account assets:cash
account liabilities:kids
  + assert virtual-only
account income:gifts

2025-01-27
  | A gift, half of which is earmarked for the kids
  * assets:cash      +100.00 CHF
  * income:gifts     -100.00 CHF
  ! liabilities:kids  -50.00 CHF
  + assert virtual liabilities:kids = -50.00 CHF
